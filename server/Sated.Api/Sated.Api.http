POST {{secureHost}}/api/foods
Content-Type: application/json

{
  "description": "Telemea de oaie",
  "category": "Cheese",
  "calories": 250,
  "protein": 17,
  "fat": 20,
  "carbohydrate": 1,
  "fiber": 0,
  "saturatedFat": 12,
  "sodium": 900,
  "calcium": 450
}

